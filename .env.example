# ---- Backend ----
# Defaults to a local SQLite file if unset — works out of the box, zero config.
# Set to a Postgres DSN for persistent/production storage:
DATABASE_URL=postgresql://foodflow:foodflow@localhost:5432/foodflow

STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional explicit path to the bundled sample dataset (auto-detected otherwise)
SAMPLE_CSV_PATH=../data/sample_food_delivery_orders.csv

# ---- Frontend ----
# Used only by `vite dev` to proxy /api to the backend during local development
VITE_API_PROXY_TARGET=http://localhost:8000
